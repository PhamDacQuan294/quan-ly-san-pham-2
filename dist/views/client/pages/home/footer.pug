.footer
  .container
    .footer__main
      .footer__cat
        img.footer__cat-img(src="/client/images/cat5.png" alt="cat illustration")

      .footer__content
        .footer__logo
          img.footer__logo-img(src="/client/images/logo2.png" alt="LuxCat")
          p.footer__slogan Cát mịn cho boss xịn

        form.footer__form
          input.footer__input(type="email" placeholder="Your Email")
          button.footer__btn(type="submit") Sign Up

      .footer__info
        .footer__contact
          p.footer__label Tên Công Ty
          p.footer__company Company
          a.footer__phone(href="tel:+84180033355") (84) - 1800 33355
          p.footer__address 184 Mayfieldd St. Hopewell, Junction, NY 12533

        .footer__social
          span.footer__social-label Follow Us.

          ul.footer__social-list
            li
              a.footer__social-link(href="#") 
                i.fa-brands.fa-facebook-f
            li
              a.footer__social-link(href="#") 
                i.fa-brands.fa-twitter
            li
              a.footer__social-link(href="#") 
                i.fa-brands.fa-youtube
            li
              a.footer__social-link(href="#") 
                i.fa-brands.fa-instagram